{
  "name": "altinn-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Utforskende QA-agent for Altinn 3-apper, bygget på Claude API",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "explore:at22": "tsx --env-file-if-exists=.env src/explore.ts --env=at22",
    "explore:at23": "tsx --env-file-if-exists=.env src/explore.ts --env=at23",
    "explore:tt02": "tsx --env-file-if-exists=.env src/explore.ts --env=tt02",
    "explore": "tsx --env-file-if-exists=.env src/explore.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
