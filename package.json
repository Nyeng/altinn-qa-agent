{
  "name": "altinn-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Utforskende QA-agent for Altinn 3-apper, bygget på Claude API",
  "type": "module",
  "scripts": {
    "explore": "tsx --env-file-if-exists=.env src/explore.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "axe-core": "4.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
