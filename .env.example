# Claude API (eller bruk `ant auth login`)
ANTHROPIC_API_KEY=

# Modell og innsats (effort: low | medium | high | xhigh | max)
QA_MODEL=claude-opus-5-5
QA_EFFORT=medium

# Appen som testes. Agenten får KUN snakke med denne verten.
# Lokalt: app-localtest. Aldri prod.
TARGET_BASE_URL=http://local.altinn.cloud
TARGET_APP_PATH=/ttd/min-app

# Hemmeligheter - legges på av verktøyet, Claude ser dem aldri.
# Hent samme verdier som k6-/Playwright-prosjektet bruker.
TARGET_BEARER_TOKEN=

# Sikkerhetsgrenser
QA_MAX_STEPS=40
QA_ALLOW_DELETE=false
