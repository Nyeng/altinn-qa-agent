# Felles for alle miljøer. Miljøspesifikt (org, app, token, API-nøkler, testbruker)
# ligger i configs/<miljø>.json lokalt, eller secret QA_CONFIG_<MILJØ> i CI.

ANTHROPIC_API_KEY=
QA_MODEL=claude-opus-5-5
QA_EFFORT=medium              # low | medium | high | xhigh | max
QA_ENV=local                  # standard hvis ingen --env er gitt

# Altinn test token generator - felles for alle miljøer
TOKEN_GENERATOR_USERNAME=
TOKEN_GENERATOR_PASSWORD=
