# Felles for alle miljøer. Det som hører til hvert miljø (faste testbrukere, ressurser, flagg) ligger i
# environments/<miljø>.json, som er sjekket inn. Hemmelighetene derfra settes her (se nederst), eller i
# configs/<miljø>.json i K6-formatet lokalt / secret QA_CONFIG_<MILJØ> i CI, som vinner. Alt er valgfritt.

ANTHROPIC_API_KEY=
QA_MODEL=claude-sonnet-5-5    # eller claude-opus-5-5 for ekstra grundige økter
QA_EFFORT=low                 # low | medium | high | xhigh | max
QA_ENV=at23                   # standard hvis ingen --env er gitt
QA_MAX_STEPS=25               # maks verktøykall per økt
QA_MAX_SESSION_TOKENS=400000  # tokentak per økt

# Altinn test token generator - felles for alle miljøer (samme som platform-validation-tests)
TOKEN_GENERATOR_USERNAME=
TOKEN_GENERATOR_PASSWORD=

# Subscription keys per miljø (samme som i K6), brukt av environments/<miljø>.json
REGISTER_SUBSCRIPTION_KEY_AT22=
AUTHORIZATION_SUBSCRIPTION_KEY_AT22=
REGISTER_SUBSCRIPTION_KEY_AT23=
AUTHORIZATION_SUBSCRIPTION_KEY_AT23=
REGISTER_SUBSCRIPTION_KEY_TT02=
AUTHORIZATION_SUBSCRIPTION_KEY_TT02=
