# ── Claude API (eller bruk `ant auth login`) ──────────────────────────
ANTHROPIC_API_KEY=
QA_MODEL=claude-opus-5-5
QA_EFFORT=medium              # low | medium | high | xhigh | max

# ── Appen som testes ─────────────────────────────────────────────────
# Miljø velges per kjøring: npm run explore:at22 / explore:at23 / explore:tt02
# (eller QA_ENV=at22). Gir https://{org}.apps.{miljø}/{org}/{app}
ALTINN_ORG=ttd
ALTINN_APP=min-app
QA_ENV=local                  # standard hvis ingen --env er gitt
TARGET_BASE_URL=http://local.altinn.cloud   # brukes kun for local

# ── Hemmeligheter (samme som k6/Playwright) - Claude ser dem aldri ───
# Alternativ 1: statisk token per miljø
TOKEN_AT22=
TOKEN_AT23=
TOKEN_TT02=
TOKEN_LOCAL=

# Alternativ 2: Altinn test token generator (brukes hvis TOKEN_<MILJØ> er tom)
# Sjekk navn/parametre mot k6-prosjektet deres.
TOKEN_GENERATOR_USERNAME=
TOKEN_GENERATOR_PASSWORD=
TOKEN_SCOPES=altinn:portal/enduser
TEST_USER_ID=
TEST_PARTY_ID=
TEST_USER_PID=

# ── Sikkerhetsgrenser ────────────────────────────────────────────────
QA_MAX_STEPS=40
QA_ALLOW_DELETE=false
